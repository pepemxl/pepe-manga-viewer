# pepe-manga env overrides — copy to `.env` and edit.
#
# HOST_MEDIA_DIR points at a folder on YOUR HOST machine. docker compose
# bind-mounts it (read-only) into the backend container at /host.
# After changing this, restart with `docker compose up -d`. Then in the
# UI go to Settings → Sources and add /host (or any subfolder) as a source.
#
# Examples:
#   HOST_MEDIA_DIR=/home/pepe/Mangas
#   HOST_MEDIA_DIR=/mnt/d/Comics
#   HOST_MEDIA_DIR=$HOME/Downloads/manga
#
# If you leave it pointing at the sample folder, /host will just mirror /manga.
HOST_MEDIA_DIR=./backend/sample_manga
