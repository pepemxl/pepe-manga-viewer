# Release signing credentials for `./gradlew assembleRelease` (and `make android-apk`).
#
# Copy this file to `keystore.properties` (which is git-ignored) and fill in your
# values. `storeFile` may be absolute or relative to the android_native/ folder.
#
# Generate a keystore once with:
#   keytool -genkeypair -v -keystore release.jks -alias pepe-manga \
#       -keyalg RSA -keysize 2048 -validity 10000
# (or: `make android-keystore` from the repo root)
#
# In CI you can omit this file and instead set the equivalent env vars:
#   ANDROID_KEYSTORE_FILE, ANDROID_KEYSTORE_PASSWORD, ANDROID_KEY_ALIAS, ANDROID_KEY_PASSWORD

storeFile=release.jks
storePassword=changeit
keyAlias=pepe-manga
keyPassword=changeit
